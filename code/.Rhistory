library(rgwas)
library(data.table)
library(jsonlite)
read_matrix <- function(path) {
  # if csv/tsv: assumes that the first column is index names
  ext <- tools::file_ext(path)
  if (ext == "csv") { x <- as.matrix(read.csv(path, row.names = 1, check.names = FALSE)) }
  else if (ext == "tsv") { x <- as.matrix(read.delim(path, row.names = 1, check.names = FALSE)) }
  else { stop("Unsupported file type: ", ext) }
  storage.mode(x) <- "double"
  x
}
Z_path <- '/gpfs/commons/groups/gursoy_lab/anewbury/unsupervised_pheno/example_data/Z.csv'
Z <- read_matrix(Z_path)
Z
stopifnot(any(apply(Z, 2, function(col) all(col == 1))))
G <- read_matrix('/gpfs/commons/groups/gursoy_lab/anewbury/unsupervised_pheno/example_data/G.csv')
C <- read_matrix('/gpfs/commons/groups/gursoy_lab/anewbury/unsupervised_pheno/example_data/C.csv')
covars <- cbind(G,Z)
covars
C_binary <- (C != 0) + 0L
 mfmr(Yb=C_binary,  Yq=NULL, G=covars, K=3, nrun=1)
q()
